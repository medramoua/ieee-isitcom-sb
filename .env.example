# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32  (min 32 chars)
NEXTAUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Set these once in the server environment to enable admin image uploads.
# Keep the API secret private; admins only use the upload form.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Leave empty in dev: reset emails get printed in the terminal
RESEND_API_KEY=""
EMAIL_FROM="IEEE ISITCom <no-reply@example.com>"
