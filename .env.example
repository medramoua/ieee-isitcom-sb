# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Set both URLs to your deployed HTTPS domain in production.
NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32  (min 32 chars)
NEXTAUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Set these once in the server environment to enable admin image uploads.
# Keep the API secret private; admins only use the upload form.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Email is sent with Resend when configured. Leave the key empty in dev to print
# setup/reset links in the server terminal instead.
RESEND_API_KEY=""
# Must use a sender address/domain verified in Resend.
EMAIL_FROM="IEEE ISITCom <no-reply@example.com>"
